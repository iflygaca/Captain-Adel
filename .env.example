# Captain Adel — service configuration. Copy to .env (never commit .env).

# HTTP port
PORT=8787

# ─────────────────────────────────────────────────────────────────────────────
# RECOMMENDED Arabic-quality setup for captadel.com:
#   1. GEMINI_API_KEY            — the English agentic path (+ fallback)
#   2. ALLAM_BASE_URL/_API_KEY   — Captain Adel's Arabic voice, in-Kingdom (below)
#   3. EMBEDDINGS_BASE_URL       — cross-lingual dense recall so an Arabic question
#      finds the right (English) GACAR passage; then `npm run build:embeddings`
# The browser sends provider=auto, so Arabic questions route to ALLaM automatically
# (route.js). Adel quotes the regulation verbatim in English and explains in Arabic.
# ─────────────────────────────────────────────────────────────────────────────

# Model routing: gemini | allam | jais | fanar | qwen | commandr | auto
#   gemini -> agentic tool-calling (default English path)
#   <name> -> retrieve-then-read against that self-hosted endpoint
#   auto   -> Arabic-dominant questions go to the first configured Arabic model
#             (ARABIC_PROVIDERS order, ALLaM first), else Gemini
MODEL_PROVIDER=gemini

# Optional: which Arabic model `auto` prefers (allam | jais | fanar | qwen |
# commandr). Default: allam.
ARABIC_PROVIDER=

# Gemini (default English path)
GEMINI_API_KEY=
CAPTAIN_ADEL_MODEL=gemini-2.5-flash
# Per-request timeout for Gemini calls, milliseconds. Default 60000.
ADEL_GEMINI_TIMEOUT_MS=

# Arabic / in-Kingdom models — each is an OpenAI-compatible vLLM/TGI endpoint and
# is OFF until its *_BASE_URL is set. See docs/models.md for the slot-B ranking.

# ALLaM-7B-Instruct (HUMAIN, Apache-2.0) — the default Arabic path.
#   Hugging Face recipe: deploy humain-ai/ALLaM-7B-Instruct-preview as a dedicated
#   Inference Endpoint (vLLM). It is endpoints_compatible but has no serverless
#   provider, so a dedicated GPU endpoint is required. From the endpoint Overview:
#     ALLAM_BASE_URL = https://<id>.endpoints.huggingface.cloud/v1   (code appends /chat/completions)
#     ALLAM_API_KEY  = hf_…  (your HF token)
#     ALLAM_MODEL    = the served model id the endpoint expects (often the repo id below, or "tgi")
#   PDPL: HF endpoints run US/EU — great for dev + evals (eval:allam / eval:parity).
#   For production with REAL user questions, host ALLaM in-Kingdom and point here.
ALLAM_BASE_URL=
ALLAM_MODEL=humain-ai/ALLaM-7B-Instruct-preview
ALLAM_API_KEY=

# Jais (Inception/G42, Arabic-first).
JAIS_BASE_URL=
JAIS_MODEL=inceptionai/jais-13b-chat
JAIS_API_KEY=

# Fanar (QCRI, strong MSA).
FANAR_BASE_URL=
FANAR_MODEL=QCRI/Fanar-1-9B-Instruct
FANAR_API_KEY=

# Qwen2.5-Instruct (Alibaba, Apache-2.0) — instruction-following workhorse.
QWEN_BASE_URL=
QWEN_MODEL=Qwen/Qwen2.5-14B-Instruct
QWEN_API_KEY=

# Command R (Cohere) — strong grounded citations. NOTE: the open weights are
# CC-BY-NC (research / eval only unless you hold a commercial licence).
COMMANDR_BASE_URL=
COMMANDR_MODEL=CohereForAI/c4ai-command-r-v01
COMMANDR_API_KEY=

# Hybrid retrieval (optional, OFF by default) — the cross-lingual unlock so an
# Arabic question finds the right (English) GACAR passage. Set EMBEDDINGS_BASE_URL
# and build the dense index once (npm run build:embeddings) to fuse BM25 with dense
# recall; set RERANK_BASE_URL to add a cross-encoder rerank. With neither set,
# retrieval is pure BM25 and unchanged.
#   Hugging Face recipe (BGE-M3 is MIT + has live hf-inference serverless):
#     - dedicated TEI endpoint -> EMBEDDINGS_BASE_URL = https://<id>.endpoints.huggingface.cloud/v1
#       (the /v1 matters — the client posts /v1/embeddings and reads {data:[{embedding}]})
#     - EMBEDDINGS_API_KEY = hf_…
#   Embeddings only ever see the public GACAR corpus (not user data), so any region
#   is fine here — no PDPL constraint, unlike the chat model above.
EMBEDDINGS_BASE_URL=
EMBEDDINGS_MODEL=BAAI/bge-m3
EMBEDDINGS_API_KEY=
RERANK_BASE_URL=
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_API_KEY=

# Optional server-to-server key — grants the trusted tier (skips the browser
# rate limiter). Set the same value as Fly GACA's ADEL_API_KEY secret.
ADEL_API_KEY=

# Comma-separated browser origin allowlist. Empty uses the built-in defaults
# (captadel.com + flygaca.com families).
ALLOWED_ORIGINS=

# Abuse rate limits (per process / replica)
ADEL_RL_IP=40
ADEL_RL_BURST=6
ADEL_RL_SESSION=24

# How many sources each answer surfaces to the UI (grounding still weighs them
# all). Keeps replies tight instead of a long cite list. Default 3.
ADEL_MAX_SOURCES=3

# ─────────────────────────────────────────────────────────────────────────────
# SaaS layer (accounts, billing, quota) — ships DARK: with none of these set,
# sign-in/billing are inert and every caller is unmetered. See
# docs/RUNBOOK-captadel-saas.md. Secrets live in Secret Manager in production.
# ─────────────────────────────────────────────────────────────────────────────

# Absolute site origin for the Moyasar callback URL (checkout return leg).
SITE_URL=https://captadel.com

# Firebase project for the Admin SDK (auto on Cloud Run via GOOGLE_CLOUD_PROJECT).
FIREBASE_PROJECT_ID=

# Moyasar — merchant of record: BDA Company International (شركة بدع الدولية),
# CR 7030976893, VAT 311415259500003. Empty secret = billing endpoints return
# 503. Prices are SAR strings (converted to halalas server-side); the browser
# never chooses an amount. The publishable key is served to the client via
# GET /v1/config for the hosted widget.
MOYASAR_SECRET_KEY=
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_WEBHOOK_SECRET=
MOYASAR_PRICE_MONTHLY_SAR=35
MOYASAR_PRICE_ANNUAL_SAR=299

# Shared secret guarding POST /v1/billing/renewals/run (Cloud Scheduler sends it
# as the X-Cron-Key header). Empty = the renewals route always 401s.
CRON_SECRET=

# Free-tier metering. 0 = dormant (only the abuse rate limiter runs).
ADEL_DAILY_FREE=0
ADEL_DAILY_ANON=0
ADEL_FREE_PERIOD=day

# LAUNCH MODE — 'free' makes every caller read as Pro while billing paperwork
# completes. Empty = normal metering.
ADEL_LAUNCH_MODE=
