rules_version = '2';

// ============================================================================
// Captain Adel (captadel.com) — Firestore security rules.
//
// The browser NEVER opens a Firestore connection: a pilot's plan and remaining
// quota are served by the Captain Adel service via GET /v1/me (Admin SDK), and
// entitlements are written only by the Moyasar billing routes (Admin SDK). The Admin SDK
// bypasses these rules, so the safest possible policy is to deny every direct
// client read and write. There is nothing here a client is meant to reach.
//
// Collections written server-side: users/{uid} (profile + entitlement),
// subscriptions/{uid}, moyasarCustomers/{uid}, checkoutIntents/{uuid},
// moyasarPayments/{paymentId} (billing), and adelQuota/{period__key}
// (usage counters, TTL-purged on expireAt).
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
