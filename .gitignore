node_modules/
.env
.env.local
*.log

# Faithfulness judge-result cache (evals/run.js --faithfulness)
evals/.cache/

# Raw drafts from evals/gen-cases/ — human-curated before merging into cases.json
evals/gen-cases/drafts/*
!evals/gen-cases/drafts/.gitkeep

# Keep the example env tracked (the repo-root .gitignore excludes .env.*)
!.env.example

# Python bytecode (authoring/ reference scripts)
__pycache__/
*.pyc

# Dense embeddings index artifacts (built on demand or served from storage)
src/brain/_embeddings.bin
src/brain/_embeddings.json.gz

# macOS & iOS
.DS_Store
.vercel
.env*
.build/
ios/.build/
*.xcodeproj
!ios/project.yml

# Metrics collection (git-ignored)
.stats.json
